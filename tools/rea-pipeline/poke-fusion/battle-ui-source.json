{
  "source": "D:\\新建文件夹\\2026-10-22\\poke-catch-https-pokecatch-online-netlify\\outputs\\pokecatch-reference\\evidence\\source\\bundle\\app.4cbef38437.css",
  "sha256": "4cbef384377661d4034ac6bd3878042fcf7d5cf4de35a24aa7b036f6efbaa729",
  "rules": [
    ".hp{height:7px;background:#3a3f52;border:2px solid #1b1b22;border-radius:6px;overflow:hidden}",
    ".hp>div{height:100%;transition:width .35s ease-out,background .3s}",
    ".hp{height:12px;border-width:2px;border-radius:4px;background:#3a2a33}",
    ".hp>div{box-shadow:inset 0 3px #ffffff59,inset 0 -2px #0000002e}",
    ".mini-hp .hp{height:10px}",
    ".mini-hp .hp{height:20px;border-width:3px;border-radius:5px}",
    ".mini-hp .hp>div{box-shadow:inset 0 5px #ffffff59,inset 0 -3px #0000002e}",
    ".mini-hp .hp{height:15px}",
    ".mini-hp .hp>div{box-shadow:inset 0 4px #ffffff59,inset 0 -2px #0000002e}",
    ".bag-tip{position:absolute;z-index:5;width:max-content;max-width:220px;padding:var(--s2) var(--s3);background:var(--sunken);border:2px solid var(--line);border-radius:10px;font-size:var(--fs-caption);pointer-events:none}",
    ".bag-tip p{margin:2px 0 0;color:var(--muted)}",
    ".tl-rail{flex:1;min-width:0;display:flex;align-items:center;gap:var(--s2);padding:0 var(--s3);background:var(--panel);border-radius:var(--r-pill);font-size:var(--fs-caption)}",
    ".tl-rail .tl-zone{flex:none;width:110px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
    ".tl-rail .tl-count{flex:none;min-width:36px;text-align:right}",
    ".tl-rail .tl-count{color:var(--yellow);font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}",
    ".tl-rail .timeline{flex:1;min-width:0;display:flex;align-items:center;gap:0;margin:0;padding:2px 24px;background:none;border:0;border-radius:0;box-shadow:none;overflow-x:auto;scrollbar-width:none;mask-image:linear-gradient(90deg,transparent,#000 24px,#000 calc(100% - 24px),transparent)}",
    ".tl-rail .timeline::-webkit-scrollbar{display:none}",
    ".tl-rail .tl-link{flex:none;width:16px;height:4px;background:linear-gradient(color-mix(in srgb,var(--green) 50%,var(--sunken)),color-mix(in srgb,var(--green) 50%,var(--sunken))) left / 0% 100% no-repeat,var(--line);transition:background-size .35s ease-out}",
    ".tl-rail .tl-link.on{background-size:100% 100%}",
    ".tl-rail .tl-node{transition:width .3s var(--ease-juicy),height .3s var(--ease-juicy),background-color .3s ease .15s,transform .3s var(--ease-juicy)}",
    ".tl-rail .tl-node,.tl-rail .tl-node.gym{width:12px;height:12px;flex:none;border-radius:4px;border:2px solid var(--ink);background:var(--panel-2);color:var(--text-2);font-size:10px;font-weight:700;line-height:1;display:flex;align-items:center;justify-content:center;overflow:visible;transform:none;animation:none;box-shadow:none}",
    ".tl-rail .tl-node.done:after{content:none}",
    ".tl-rail .tl-node.fight{background:var(--red)}",
    ".tl-rail .tl-node.done{opacity:1;background:var(--green)}",
    ".tl-rail .tl-node.heal,.tl-rail .tl-node.ev{width:22px;height:22px;border:0;background:none;border-radius:var(--r-xs)}",
    ".tl-rail .tl-node.gym{width:22px;height:22px;border-radius:var(--r-xs);border-color:var(--yellow)}",
    ".tl-rail .tl-node.gym.done{border-color:var(--green);background:var(--panel-2)}",
    ".tl-rail .tl-node img,.tl-rail .tl-node img.tl-badge,.tl-rail .tl-node img.tl-legend{width:22px;height:22px;image-rendering:pixelated}",
    ".tl-rail .tl-node.gym img,.tl-rail .tl-node.gym img.tl-badge{width:16px;height:16px}",
    ".tl-rail .tl-face{width:18px;height:18px;border-radius:4px}",
    ".tl-rail .tl-node .pbadge{--z: 1 !important}",
    ".tl-rail .tl-node.misc:not(.done){width:auto;min-width:12px;border:0;background:none;color:var(--text);font-size:var(--fs-body);font-weight:700}",
    ".tl-rail .timeline{position:relative}",
    ".tl-rail .tl-cursor{position:absolute;top:50%;left:0;width:14px;height:14px;translate:-50% -50%;border-radius:4px;border:2px solid var(--ink);background:var(--text);pointer-events:none;transition:left .45s var(--ease-juicy),width .25s ease,height .25s ease,border-radius .25s ease}",
    ".tl-rail .tl-cursor.frame{width:30px;height:30px;border-radius:var(--r-xs);border-color:var(--text);background:none}",
    ".tl-rail .tl-node.misc.current{color:transparent}",
    ".tl-rail .tl-node.wild{width:18px;height:18px;border:0;background:none}",
    ".tl-rail .tl-node.wild img.tl-grass{width:18px;height:16px}",
    ".tl-rail .tl-node.wild.done{background:none;opacity:.5}",
    ".tl-rail .tl-node.wild.current,.tl-rail .tl-node.heal.current,.tl-rail .tl-node.gym.current,.tl-rail .tl-node.ev.current{transform:scale(1.15)}",
    ".tl-rail{flex:1 0 100%}"
  ],
  "direction": "source .ally img scaleX(-1); .enemy img unchanged",
  "hp": "source qa ratio > 0.2 ? #f0607a : #d6334f",
  "types": "Original typeBadge: colored text badges; no standalone type artwork in fixed asset packs."
}